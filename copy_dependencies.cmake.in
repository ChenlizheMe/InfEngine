# Auto-generated script to copy DLL dependencies
if(NOT TARGET_DIR)
    set(TARGET_DIR "@PYTHON_TARGET_DIR@")
endif()
file(TO_CMAKE_PATH "${TARGET_DIR}" TARGET_DIR)
set(BUILD_DIR "@CMAKE_BINARY_DIR@")
set(SOURCE_DIR "@CMAKE_SOURCE_DIR@")
set(MSVC_RUNTIME_DLLS "@CMAKE_INSTALL_SYSTEM_RUNTIME_LIBS@")
include("@CMAKE_SOURCE_DIR@/cmake/stable_copy.cmake")

set(_copied_names "")

# Function to copy file if it exists
macro(copy_if_exists src dest)
    if(EXISTS "${src}")
        get_filename_component(_copy_name "${src}" NAME)
        # Binding modules are staged by stage_native_module.cmake, which also
        # removes other Python ABI variants. They are not shared dependencies.
        if(NOT _copy_name MATCHES "^_Infernux(Bootstrap)?([._]|$)")
            list(FIND _copied_names "${_copy_name}" _copy_index)
            if(_copy_index EQUAL -1)
                list(APPEND _copied_names "${_copy_name}")
                set(_copy_destination "${dest}/${_copy_name}")
                file(TO_CMAKE_PATH "${src}" _copy_source_normalized)
                file(TO_CMAKE_PATH "${_copy_destination}" _copy_destination_normalized)
                if(NOT _copy_source_normalized STREQUAL _copy_destination_normalized)
                    message(STATUS "Staging ${_copy_name} to ${dest}")
                    infernux_copy_file_stable("${src}" "${_copy_destination}")
                endif()
            endif()
        endif()
    else()
        message(STATUS "File not found: ${src}")
    endif()
endmacro()

# Use the build configuration passed from CMake (Release / RelWithDebInfo / etc.)
# Falls back to Release if not provided.
if(NOT INFERNUX_BUILD_CFG)
    set(_CFG "Release")
else()
    set(_CFG "${INFERNUX_BUILD_CFG}")
endif()

# Determine shared library extension based on platform
if(WIN32)
    set(_SHARED_LIB_EXT "dll")
elseif(APPLE)
    set(_SHARED_LIB_EXT "dylib")
else()
    set(_SHARED_LIB_EXT "so")
endif()

# List of known library directories to search
# On Windows these use per-config subdirectories; on single-config
# generators (Ninja) the libraries sit directly in the directory.
if(WIN32)
    set(LIB_SEARCH_DIRS
        "${BUILD_DIR}/external/${_CFG}"
        "${BUILD_DIR}/external/assimp/bin/${_CFG}"
        "${BUILD_DIR}/external/glslang/glslang/${_CFG}"
        "${BUILD_DIR}/external/glslang/SPIRV/${_CFG}"
        "${BUILD_DIR}/external/SDL/${_CFG}"
        "${BUILD_DIR}/external/JoltPhysics/${_CFG}"
        "${BUILD_DIR}/${_CFG}"
    )
else()
    set(LIB_SEARCH_DIRS
        "${BUILD_DIR}/external"
        "${BUILD_DIR}/external/assimp/bin"
        "${BUILD_DIR}/external/glslang/glslang"
        "${BUILD_DIR}/external/glslang/SPIRV"
        "${BUILD_DIR}/external/SDL"
        "${BUILD_DIR}/external/JoltPhysics"
        "${BUILD_DIR}"
    )
endif()

# Search for shared library files in the build directories
foreach(search_dir ${LIB_SEARCH_DIRS})
    if(EXISTS "${search_dir}")
        if(UNIX AND NOT APPLE)
            # Linux consumers link against ELF SONAMEs such as libSDL3.so.0
            # and libassimp.so.6. Staging only the unversioned development
            # symlink produces a package that cannot load on a clean machine.
            file(GLOB lib_files "${search_dir}/*.${_SHARED_LIB_EXT}*")
        else()
            file(GLOB lib_files "${search_dir}/*.${_SHARED_LIB_EXT}")
        endif()
        foreach(lib_file ${lib_files})
            copy_if_exists("${lib_file}" "${TARGET_DIR}")
        endforeach()
    endif()
endforeach()

# Do not recursively scan the build tree. It contains previous ABI outputs,
# wheel verification stages and TARGET_DIR itself. Copying from those generated
# trees can resurrect stale native modules after stage_native_module.cmake has
# removed them. Every runtime-producing directory must be listed explicitly in
# LIB_SEARCH_DIRS above.

# Copy the MSVC runtime DLLs discovered by CMake so wheel installs work on clean machines.
if(WIN32)
    foreach(runtime_dll ${MSVC_RUNTIME_DLLS})
        copy_if_exists("${runtime_dll}" "${TARGET_DIR}")
    endforeach()
endif()

message(STATUS "Finished copying shared library dependencies to ${TARGET_DIR}")
