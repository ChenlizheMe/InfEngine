{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release Preset (Windows / MSVC)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "INFERNUX_BUILD_PLAYER_HOST": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Preset (Windows, RelWithDebInfo + Profiling)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/out/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "INFERNUX_BUILD_PLAYER_HOST": "OFF"
      }
    },
    {
      "name": "debug-profile",
      "displayName": "Debug Profile Preset (Windows, terminal frame profiling)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/out/build-profile",
      "cacheVariables": {
        "INFERNUX_FRAME_PROFILE_TERMINAL": "ON"
      }
    },
    {
      "name": "debug-no-vulkan-validation",
      "displayName": "Debug Preset (Windows, RelWithDebInfo, Vulkan validation off)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/out/build-debug-no-vulkan-validation",
      "cacheVariables": {
        "INFERNUX_ENABLE_VULKAN_VALIDATION": "OFF"
      }
    },
    {
      "name": "native-dev",
      "displayName": "Native Development Preset (Windows, engine module only)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/out/build-native-dev",
      "cacheVariables": {
        "INFERNUX_BUILD_TESTS": "OFF",
        "INFERNUX_PYTHON_SYNC_DIR": "${sourceDir}/out/build-native-dev/python-sync"
      }
    },
    {
      "name": "native-tests",
      "displayName": "Native Test Preset (Windows, RelWithDebInfo)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/out/build-native-tests",
      "cacheVariables": {
        "INFERNUX_BUILD_TESTS": "ON",
        "INFERNUX_PYTHON_SYNC_DIR": "${sourceDir}/out/build-native-tests/python-sync"
      }
    },
    {
      "name": "release-macos",
      "displayName": "Release Preset (macOS / Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build-macos-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-macos",
      "displayName": "Debug Preset (macOS, RelWithDebInfo + Profiling)",
      "inherits": "release-macos",
      "binaryDir": "${sourceDir}/out/build-macos-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "release-linux",
      "displayName": "Release Preset (Linux / Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build-linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-linux",
      "displayName": "Debug Preset (Linux)",
      "inherits": "release-linux",
      "binaryDir": "${sourceDir}/out/build-linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "jobs": 8,
      "targets": [
        "package_and_install_python"
      ]
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "RelWithDebInfo",
      "jobs": 8,
      "targets": [
        "package_and_install_python"
      ]
    },
    {
      "name": "debug-profile",
      "configurePreset": "debug-profile",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "debug-no-vulkan-validation",
      "configurePreset": "debug-no-vulkan-validation",
      "configuration": "RelWithDebInfo",
      "jobs": 8,
      "targets": [
        "package_and_install_python"
      ]
    },
    {
      "name": "native-dev",
      "configurePreset": "native-dev",
      "configuration": "RelWithDebInfo",
      "targets": [
        "_Infernux"
      ]
    },
    {
      "name": "native-tests",
      "configurePreset": "native-tests",
      "configuration": "RelWithDebInfo",
      "jobs": 8
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "jobs": 8,
      "targets": ["package_and_install_python"]
    },
    {
      "name": "debug-macos",
      "configurePreset": "debug-macos",
      "jobs": 8,
      "targets": ["package_and_install_python"]
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux",
      "jobs": 8,
      "targets": ["package_and_install_python"]
    },
    {
      "name": "debug-linux",
      "configurePreset": "debug-linux",
      "jobs": 8,
      "targets": ["package_and_install_python"]
    },
    {
      "name": "format",
      "configurePreset": "release",
      "configuration": "Release",
      "targets": [
        "clang_format"
      ]
    },
    {
      "name": "wiki",
      "configurePreset": "release",
      "configuration": "Release",
      "targets": [
        "build_wiki_html"
      ]
    },
    {
      "name": "packaging",
      "configurePreset": "release",
      "configuration": "Release",
      "targets": [
        "infernux_hub"
      ]
    },
    {
      "name": "packaging-installer",
      "configurePreset": "release",
      "configuration": "Release",
      "targets": [
        "infernux_hub_installer"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-no-vulkan-validation",
      "configurePreset": "debug-no-vulkan-validation",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-tests",
      "configurePreset": "native-tests",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-macos",
      "configurePreset": "release-macos",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-macos",
      "configurePreset": "debug-macos",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-linux",
      "configurePreset": "release-linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "debug-linux",
      "configurePreset": "debug-linux",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
