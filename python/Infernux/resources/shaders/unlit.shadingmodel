ShadingModelInfo {
    Name "Unlit"
}

// ============================================================================
// unlit.shadingmodel — Unlit Shading Model (no lighting evaluation)
//
// Simply outputs albedo + emission. It has no Lighting requirement. The same
// shading() function is selected by every supported render path.
//
// Referenced by surface shaders via ShaderInfo ShadingModel: Unlit
// ============================================================================


// ============================================================================
// Pipeline-agnostic direct color output (no lighting)
// ============================================================================
void shading(in SurfaceData s, out vec4 color) {
    color = vec4(s.albedo + s.emission, s.alpha);
}
