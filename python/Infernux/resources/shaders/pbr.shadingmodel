ShadingModelInfo {
    Name "PBR"
    Imports ["Lighting", "PBR"]
    Requires [Lighting]
}

// ============================================================================
// pbr.shadingmodel — Standard PBR (Cook-Torrance) Shading Model
//
// One shading() function serves Forward, Forward+, Deferred and compatible
// custom pipelines. Imports provide pure GLSL functions; Requires asks the
// compiler to bind the camera-local lighting contract. GBuffer packing and
// Deferred dispatch are generated by the render-path adapter.
//
// Referenced by surface shaders via ShaderInfo ShadingModel: PBR
// ============================================================================


// ============================================================================
// Pipeline-agnostic PBR lighting evaluation.
// ============================================================================
void shading(in SurfaceData s, out vec4 color) {
    ShadingContext ctx = GetShadingContext();
    vec3 albedo = clamp(s.albedo, 0.0, 1.0);
    float metallic = clamp(s.metallic, 0.0, 1.0);
    float perceptualRoughness = clamp(1.0 - s.smoothness, 0.045, 1.0);
    float roughness = perceptualRoughness * perceptualRoughness;
    float ao = clamp(s.occlusion, 0.0, 1.0);
    vec3 N = normalize(s.normalWS);

    roughness = GeometricSpecularAA(N, roughness);
    perceptualRoughness = max(perceptualRoughness, sqrt(roughness));
    vec3 V = normalize(ctx.cameraPositionWS - ctx.positionWS);

    vec3  F0    = mix(vec3(0.04), albedo, metallic);
    float f90   = ComputeF90(F0);
    float NdotV = max(dot(N, V), 0.0);

    vec2  envBrdf      = EnvBRDFApprox(perceptualRoughness, NdotV);
    float reflectivity = envBrdf.x + envBrdf.y;
    vec3  energyCompensation = 1.0 + F0 * (1.0 / max(reflectivity, 0.001) - 1.0);

    Light mainLight = getMainLight(ctx.positionWS, N, ctx.viewDepth);
    vec3 Lo = calculateAllLighting(ctx.positionWS, N, V,
                                   albedo, metallic,
                                   roughness, perceptualRoughness,
                                   F0, f90, energyCompensation,
                                   s.specularHighlights,
                                   ctx.viewDepth, mainLight.shadow);

    // ---- Indirect diffuse: cosine-convolved irradiance (SH-style) ----
    // Diffuse GI does not depend on roughness in the split-sum convention;
    // the irradiance sample is already hemisphere-integrated.
    vec3 diffuseIrradiance = sampleAmbientIrradiance(N);

    // ---- Indirect specular: analytic prefiltered-probe stand-in ----
    // Sample the sky radiance model along the dominant reflection direction,
    // then blend toward cosine-convolved irradiance as the GGX lobe widens.
    // This mirrors a prefiltered cubemap mip chain (URP mip curve), and it
    // applies to metals exactly like dielectrics — rough metals must show
    // blurred reflections, not a sharp sky gradient.
    vec3 reflDir = getSpecularAmbientDirection(N, V, perceptualRoughness);
    float prefilter = saturate(perceptualRoughness * (1.7 - 0.7 * perceptualRoughness));
    vec3 specularIrradiance = mix(sampleAmbientProbe(reflDir),
                                  sampleAmbientIrradiance(reflDir),
                                  prefilter);

    vec3 kS_env = F_SchlickRoughness(F0, f90, NdotV, perceptualRoughness);
    vec3 kD_env = (1.0 - kS_env) * (1.0 - metallic);

    vec3 diffuseEnv = kD_env * albedo * diffuseIrradiance * ao;

    // Occlusion: AO-derived specular occlusion (Lagarde) + horizon fade so
    // normal-mapped reflection vectors cannot fetch sky light from below the
    // geometric surface. The split-sum FGD term (F0·scale + bias) already
    // handles all roughness/Fresnel energy — no extra ad-hoc attenuation.
    float specOcclusion = ComputeSpecularOcclusion(NdotV, ao, perceptualRoughness);
    vec3 geomN = normalize(ctx.geometricNormalWS);
    geomN = (dot(geomN, N) < 0.0) ? -geomN : geomN;
    float horizonFade = HorizonOcclusion(reflDir, geomN);
    vec3 specEnv = specularIrradiance
                 * (F0 * envBrdf.x + envBrdf.y)
                 * energyCompensation
                 * (specOcclusion * horizonFade)
                 * s.specularHighlights;

    vec3 ambient = diffuseEnv + specEnv;
    color = vec4(ambient + Lo + s.emission, s.alpha);
}
