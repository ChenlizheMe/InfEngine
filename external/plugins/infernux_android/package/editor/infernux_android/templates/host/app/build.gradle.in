plugins {
    id "com.android.application"
}

def infernuxKeystorePath = System.getenv("INFERNUX_ANDROID_KEYSTORE")
def infernuxKeyAlias = System.getenv("INFERNUX_ANDROID_KEY_ALIAS")
def infernuxKeystorePassword = System.getenv("INFERNUX_ANDROID_KEYSTORE_PASSWORD")
def infernuxKeyPassword = System.getenv("INFERNUX_ANDROID_KEY_PASSWORD") ?: infernuxKeystorePassword
def infernuxReleaseSigningReady = [
    infernuxKeystorePath,
    infernuxKeyAlias,
    infernuxKeystorePassword,
    infernuxKeyPassword,
].every { value -> value != null && !value.trim().isEmpty() }

android {
    namespace "com.infernux.bootstrap"
    compileSdk 36
    ndkVersion "@ANDROID_NDK_VERSION@"

    defaultConfig {
        applicationId "com.infernux.bootstrap"
        minSdk 26
        targetSdk 36
        versionCode 1
        versionName "0.1.0"

        externalNativeBuild {
            cmake {
                arguments "-DANDROID_STL=c++_shared"
                abiFilters "@ANDROID_ABI@"
            }
        }
    }

    signingConfigs {
        if (infernuxReleaseSigningReady) {
            release {
                storeFile file(infernuxKeystorePath)
                storePassword infernuxKeystorePassword
                keyAlias infernuxKeyAlias
                keyPassword infernuxKeyPassword
            }
        }
    }

    buildTypes {
        debug {
            debuggable true
        }
        release {
            minifyEnabled false
            if (infernuxReleaseSigningReady) {
                signingConfig signingConfigs.release
            }
        }
    }

    packagingOptions {
        jniLibs {
            useLegacyPackaging true
        }
    }

    androidResources {
        // AAPT's default contains <dir>_*, which silently removes Python
        // packages such as numpy/_core and numpy/_utils from assets.
        ignoreAssetsPattern = "!.svn:!.git:!.ds_store:!*.scc:.*:!CVS:!thumbs.db:!picasa.ini:!*~"
    }

    sourceSets {
        main {
            java.srcDirs += ["@INFERNUX_SOURCE_ROOT@/external/SDL/android-project/app/src/main/java"]
        }
    }

    externalNativeBuild {
        cmake {
            path "src/main/cpp/CMakeLists.txt"
            version "@ANDROID_CMAKE_VERSION@"
        }
    }
}
